# 必填：DashScope API Key（https://bailian.console.aliyun.com/ 获取）
DASHSCOPE_API_KEY=

# 可选：模型名（默认 qwen-max）
# OPENARCH_MODEL=qwen-max

# 可选：改用任意 OpenAI 兼容端点（设置后走 OpenAIChatModel）
# OPENARCH_BASE_URL=
# OPENARCH_API_KEY=

# 可选：交付物输出目录（默认 ./deliverables）
# OPENARCH_WORKSPACE=./deliverables

# 可选：技能目录覆盖（默认仓库根 skills/）
# OPENARCH_SKILLS_DIR=
